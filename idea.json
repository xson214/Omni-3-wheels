{
    "project": {
      "name": "OmniCar",
      "description": "ESP32-S3 three-wheel omni robot controlled and monitored through Streamlit.",
      "communication": {
        "network": "WiFi",
        "protocols": {
          "websocket": {
            "purpose": [
              "real-time manual joystick control",
              "start/stop commands",
              "real-time telemetry from ESP32 to Streamlit"
            ],
            "direction": "bidirectional"
          },
          "http_rest": {
            "purpose": [
              "upload trajectory",
              "retrieve stored trajectory",
              "check HTTP connectivity"
            ],
            "direction": "bidirectional"
          }
        }
      }
    },
    "streamlit": {
      "role": [
        "user interface",
        "manual RC control",
        "trajectory creation",
        "trajectory upload",
        "vehicle monitoring"
      ],
      "modes": {
        "manual": {
          "description": "Select MANUAL, send START, then hold and drag the control pad. Release sends zero.",
          "communication": "WebSocket",
          "data": {
            "type": "joystick",
            "x": "float [-1.0, 1.0]",
            "y": "float [-1.0, 1.0]"
          }
        },
        "autonomous": {
          "description": "Create and upload a trajectory, then let ESP32 execute it.",
          "communication": "HTTP REST for upload, WebSocket for commands and telemetry",
          "workflow": [
            "Create trajectory",
            "Upload trajectory",
            "ESP32 validates and stores trajectory",
            "Select AUTO",
            "Send START command",
            "ESP32 executes trajectory autonomously"
          ]
        },
        "stop": {
          "description": "Set PWM to zero and enter STOP/IDLE. Select a mode and send START for a new WebSocket run.",
          "communication": "WebSocket",
          "command": "STOP"
        }
      },
      "trajectory": {
        "format": {
          "type": "trajectory",
          "points": [
            {
              "x": 0,
              "y": 0
            },
            {
              "x": 0.5,
              "y": 0
            },
            {
              "x": 1,
              "y": 0.5
            }
          ]
        },
        "limits": {
          "points_min": 1,
          "points_max": 64,
          "coordinate_min_m": -1000,
          "coordinate_max_m": 1000,
          "reference_frame": "Odometry frame initialized at boot"
        }
      }
    },
    "esp32": {
      "role": [
        "WiFi communication",
        "WebSocket server",
        "trajectory storage",
        "path following",
        "PID control",
        "motor control",
        "encoder reading",
        "safety control"
      ],
      "control_modes": {
        "MANUAL": {
          "input": "WebSocket joystick data after selecting MANUAL and sending START",
          "processing": [
            "convert joystick x/y to body-frame vx/vy, with zero yaw rate, then compute three wheel speeds",
            "apply speed limits",
            "apply PID control",
            "control motors"
          ]
        },
        "AUTO": {
          "input": "Uploaded trajectory after selecting AUTO and sending START",
          "processing": [
            "read current position",
            "calculate target point",
            "calculate tracking error",
            "calculate desired velocity",
            "apply PID control",
            "control motors"
          ]
        },
        "STOP": {
          "processing": [
            "set target motor speed to zero",
            "stop vehicle",
            "require a new mode selection and START before a new WebSocket run"
          ]
        }
      },
      "safety": {
        "websocket_timeout_ms": 300,
        "action_on_timeout": "STOP_MOTOR",
        "description": "While a nonzero MANUAL joystick command is active, stop and disarm if no joystick message arrives for 300 ms.",
        "serial_command_timeout_ms": 200,
        "serial_description": "V, B and P must be refreshed within the timeout to keep moving."
      }
    },
    "websocket": {
      "message_types": {
        "joystick": {
          "direction": "Streamlit -> ESP32",
          "example": {
            "type": "joystick",
            "x": 0.3,
            "y": 0.8
          }
        },
        "mode": {
          "direction": "Streamlit -> ESP32",
          "example": {
            "type": "mode",
            "value": "MANUAL"
          },
          "allowed_values": [
            "MANUAL",
            "AUTO",
            "STOP"
          ]
        },
        "command": {
          "direction": "Streamlit -> ESP32",
          "allowed_values": [
            "START",
            "STOP",
            "PAUSE",
            "RESUME"
          ],
          "example": {
            "type": "command",
            "value": "START"
          }
        },
        "telemetry": {
          "direction": "ESP32 -> Streamlit",
          "example": {
            "type": "telemetry",
            "x": 1.2,
            "y": 0.8,
            "theta": 1.57,
            "speed": 0.08,
            "battery": -1,
            "mode": "AUTO",
            "state": "RUNNING",
            "traj_i": 1,
            "traj_n": 3,
            "w1": 1.5,
            "w2": -2,
            "w3": 0.5
          },
          "battery_description": "-1 indicates the measurement is unavailable."
        },
        "status": {
          "direction": "ESP32 -> Streamlit",
          "example": {
            "type": "status",
            "mode": "AUTO",
            "state": "RUNNING"
          },
          "error_description": "The optional error string explains why the request was rejected."
        }
      }
    },
    "http_api": {
      "endpoints": {
        "upload_trajectory": {
          "method": "POST",
          "path": "/trajectory",
          "purpose": "Upload a new trajectory to ESP32",
          "responses": {
            "200": "Trajectory stored without changing mode",
            "400": "Invalid or missing trajectory data",
            "409": "Robot is running or paused",
            "413": "Body exceeds 8192 bytes"
          }
        },
        "get_trajectory": {
          "method": "GET",
          "path": "/trajectory",
          "purpose": "Retrieve the currently stored trajectory"
        },
        "health": {
          "method": "GET",
          "path": "/",
          "purpose": "Check HTTP connectivity"
        }
      }
    },
    "architecture": {
      "flow": [
        "Streamlit",
        "WiFi",
        "ESP32",
        "Motor Controller",
        "Motors"
      ],
      "manual_flow": [
        "User moves virtual joystick",
        "Streamlit generates joystick command",
        "WebSocket sends command to ESP32",
        "ESP32 converts joystick command to wheel velocities",
        "PID controller calculates motor output",
        "Motor driver drives motors"
      ],
      "autonomous_flow": [
        "User creates trajectory in Streamlit",
        "Streamlit sends trajectory to ESP32 using HTTP",
        "ESP32 stores trajectory",
        "User selects AUTO",
        "User sends START command",
        "ESP32 follows trajectory",
        "ESP32 sends telemetry to Streamlit through WebSocket"
      ]
    },
    "important_constraints": [
      "Do not require firmware re-upload when trajectory changes.",
      "Trajectory is data, not firmware.",
      "Motor control and PID run locally in a dedicated task on ESP32-S3.",
      "Do not depend on Streamlit for the high-frequency motor control loop.",
      "Stop MANUAL on joystick heartbeat loss.",
      "Manual control should prioritize low latency.",
      "Autonomous mode should continue using the stored trajectory even if Streamlit temporarily disconnects."
    ]
  }
